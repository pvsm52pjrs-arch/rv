<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Помощник по выбору профессии</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Unbounded:wght@500;600&family=Manrope:wght@400;500;700&display=swap">
<style>
:root{--bg:#eef2f6;--card:#fff;--ink:#14213d;--mute:#5b6678;--line:#d5dce6;--acc:#2f5bea;--acc-ink:#fff;--soft:#e3eaff;--ok:#1f9d8b;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0f1626;--card:#18223a;--ink:#e8edf7;--mute:#9aa6bd;--line:#2b3859;--acc:#6f93ff;--acc-ink:#0f1626;--soft:#22305a;--ok:#4cc9b5}}
:root[data-theme="dark"]{--bg:#0f1626;--card:#18223a;--ink:#e8edf7;--mute:#9aa6bd;--line:#2b3859;--acc:#6f93ff;--acc-ink:#0f1626;--soft:#22305a;--ok:#4cc9b5}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:400 16px/1.55 Manrope,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
main{max-width:640px;margin:0 auto;padding:20px 16px 48px}
h1,h2{font-family:Unbounded,Manrope,system-ui,sans-serif;font-weight:600;line-height:1.2;margin:0 0 12px}
h1{font-size:26px}h2{font-size:20px}
p{margin:0 0 12px;max-width:62ch}
.mute{color:var(--mute)}
.card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:20px;margin-bottom:14px}
button{font:inherit;cursor:pointer;color:inherit;-webkit-user-select:none;user-select:none;-webkit-touch-callout:none;touch-action:manipulation}
button:focus-visible{outline:3px solid var(--acc);outline-offset:2px}
.btn{background:var(--acc);color:var(--acc-ink);border:0;border-radius:12px;padding:13px 20px;font-weight:700;min-height:48px}
.btn.ghost{background:transparent;color:var(--ink);border:1px solid var(--line)}
.opts{display:grid;gap:10px;margin-top:16px}
.opt{background:var(--bg);border:1px solid var(--line);border-radius:12px;padding:13px 16px;text-align:left;min-height:48px;transition:background .15s,border-color .15s}
.opt:hover,.opt[aria-pressed="true"]{background:var(--soft);border-color:var(--acc)}
.bar{height:6px;background:var(--line);border-radius:3px;overflow:hidden;margin-bottom:16px}
.bar i{display:block;height:100%;background:var(--acc);transition:width .3s}
.q{font-size:20px;font-weight:700;line-height:1.35}
.row{display:flex;gap:10px;flex-wrap:wrap;margin-top:16px}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}
.chip{border:1px solid var(--line);background:var(--bg);border-radius:999px;padding:9px 15px;min-height:44px}
.chip[aria-pressed="true"]{background:var(--acc);color:var(--acc-ink);border-color:var(--acc)}
.pro{display:grid;grid-template-columns:1fr auto;gap:4px 12px;align-items:baseline}
.pro h3{margin:0;font-size:18px}
.pct{font-family:Unbounded,Manrope,sans-serif;font-weight:600;color:var(--ok);font-size:18px}
.pro p{grid-column:1/-1;margin:0;color:var(--mute);font-size:15px}
.pro .why{color:var(--ink);font-size:14px}
.prof{display:grid;grid-template-columns:120px 1fr 28px;gap:10px;align-items:center;font-size:14px;margin:7px 0}
.prof b{display:block;height:10px;border-radius:5px;background:var(--acc)}
.prof span:last-child{color:var(--mute);text-align:right}
.more{grid-column:1/-1;margin-top:6px}
.more summary{cursor:pointer;font-weight:700;color:var(--acc);list-style:none;min-height:30px;display:flex;align-items:center}
.more summary::-webkit-details-marker{display:none}
.more summary:before{content:"+ ";font-weight:700}
.more[open] summary:before{content:"– "}
.more .inner{background:var(--bg);border:1px solid var(--line);border-radius:12px;padding:12px 14px;margin-top:6px}
.more .inner p{margin:0 0 8px;color:var(--ink);font-size:15px}
.more .inner p:last-child{margin-bottom:0}
.trial{grid-column:1/-1;margin-top:8px;background:var(--bg);border:1px solid var(--line);border-radius:12px;padding:14px}
.trial p{margin:0 0 8px;color:var(--ink)}
.pro>.btn{grid-column:1/-1;justify-self:start;margin-top:8px}
@media(max-width:420px){.prof{grid-template-columns:96px 1fr 24px}h1{font-size:23px}}
@media(prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
