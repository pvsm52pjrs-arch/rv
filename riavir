function go(s){st.s=s;render();window.scrollTo(0,0)}
function render(){
 if(st.s=="start"){app.innerHTML='<h1>Подберём профессию по вашим склонностям</h1><div class="card"><p>Ответьте на '+Q.length+' коротких утверждений, отметьте, что важно в работе, и получите список из '+P.length+' профессий с полным описанием: чем занимаетесь, какие предметы нужны и на какой факультет идти. Затем по каждой профессии можно пройти короткий тест и уточнить результат.</p><p class="mute">Займёт около 3 минут. Ответы остаются в браузере и никуда не отправляются.</p><div class="row"><button class="btn" id="go">Начать</button></div></div>';
  document.getElementById("go").onclick=function(){st.i=0;st.a=[];st.pr=[];st.adj={};st.ord=null;st.op="";st.mt={};Q=newQ();go("q")};}
 else if(st.s=="q"){var q=Q[st.i];
  app.innerHTML='<div class="bar"><i style="width:'+(st.i/(Q.length+1)*100)+'%"></i></div><div class="card"><p class="mute">Утверждение '+(st.i+1)+' из '+Q.length+'</p><div class="q">'+q[1]+'</div><div class="opts">'+L.map(function(l,k){return '<button class="opt" data-v="'+(k+1)+'">'+l+'</button>'}).join("")+'</div></div>'+(st.i?'<button class="btn ghost" id="back">Назад</button>':'');
  app.querySelectorAll(".opt").forEach(function(b){b.onclick=function(){st.a[st.i]=+b.dataset.v;st.i++;st.i<Q.length?render():go("pr")}});
  var bk=document.getElementById("back");if(bk)bk.onclick=function(){st.i--;render()};}
 else if(st.s=="pr"){
  app.innerHTML='<div class="bar"><i style="width:'+(Q.length/(Q.length+1)*100)+'%"></i></div><div class="card"><h2>Что важно в работе?</h2><p class="mute">Выберите до трёх пунктов или пропустите.</p><div class="chips">'+Object.keys(PR).map(function(k){return '<button class="chip" aria-pressed="'+(st.pr.indexOf(k)>-1)+'" data-k="'+k+'">'+PR[k]+'</button>'}).join("")+'</div><div class="row"><button class="btn" id="res">Показать результат</button></div></div>';
  app.querySelectorAll(".chip").forEach(function(c){c.onclick=function(){var k=c.dataset.k,ix=st.pr.indexOf(k);if(ix>-1)st.pr.splice(ix,1);else if(st.pr.length<3)st.pr.push(k);render()}});
  document.getElementById("res").onclick=function(){st.adj={};st.ord=null;st.op="";st.mt={};go("res")};}
 else result();
}
function buildAll(scObj){return P.map(function(p,ix){var b=0;[3,2,1].forEach(function(w,k){b+=w*scObj[p[1][k]]});var hit=p[2].filter(function(t){return st.pr.indexOf(t)>-1});return{p:p,ix:ix,base:Math.round(b/(6*MAX)*90+hit.length*5),hit:hit,main:p[1][0]}})}
function result(){
 var sc={R:0,I:0,A:0,S:0,E:0,C:0};
 Q.forEach(function(q,i){sc[q[0]]+=st.a[i]});
 var top=Object.keys(sc).sort(function(a,b){return sc[b]-sc[a]}).slice(0,2);
 var all=buildAll(sc);
 function pc(r){return Math.max(1,Math.min(99,r.base+(st.adj[r.p[0]]||0)))}
 if(!st.ord)st.ord=all.slice().sort(function(a,b){return pc(b)-pc(a)}).slice(0,6).map(function(r){return r.ix});
 var list=st.ord.map(function(i){return all[i]});
 var prof=Object.keys(sc).map(function(k){return '<div class="prof"><span>'+T[k]+'</span><b style="width:'+(sc[k]/MAX*100)+'%"></b><span>'+sc[k]+'</span></div>'}).join("");
 var tried=Object.keys(st.adj).length;
 app.innerHTML='<h1>Ваши сильные стороны: '+T[top[0]].toLowerCase()+' и '+T[top[1]].toLowerCase()+'</h1><div class="card"><h2>Профиль интересов</h2>'+prof+'<p class="mute">Максимум по каждому типу — '+MAX+'.</p></div><h2>Подходящие профессии</h2><p class="mute">Откройте «Подробнее», чтобы увидеть полное описание, нужные предметы и факультет. Кнопка «Пройти тест на соответствие» задаёт вопросы именно про эту работу и уточняет процент.</p>'+
 list.map(function(r){var n=r.p[0],code=r.p[1],t="",res=st.mt[n];
  if(res){t='<div class="trial"><p><b>Результат теста: '+res.pct+'% совпадения</b></p>'+(res.extra.length?'<p>По общей сумме баллов вам также подойдут:</p><div class="chips">'+res.extra.map(function(e){return '<span class="chip" style="cursor:default">'+e.name+' — '+e.pct+'%</span>'}).join("")+'</div>':'')+'</div>';}
  else if(st.op===n){var mq=QB[n],q=mq[st.ti];
   t='<div class="trial"><p class="mute">Вопрос '+(st.ti+1)+' из '+mq.length+'</p><p><b>'+q+'</b></p><div class="opts">'+L.map(function(l,k){return '<button class="opt" data-tv="'+(k+1)+'">'+l+'</button>'}).join("")+'</div></div>';}
  else t='<button class="btn ghost" data-op="'+n+'">Пройти тест на соответствие</button>';
var why=r.hit.length?'<p class="why">Совпадает с вашими приоритетами: '+r.hit.map(function(k){return PR[k]}).join(", ")+'</p>':'';
  var more='<details class="more"><summary>Подробнее</summary><div class="inner"><p>'+r.p[4]+'</p><p><b>Нужные предметы:</b> '+r.p[5].join(", ")+'</p><p><b>Куда поступать:</b> '+r.p[6]+'</p></div></details>';
  return '<div class="card pro"><h3>'+n+'</h3><span class="pct">'+pc(r)+'%</span><p>'+r.p[3]+'</p>'+why+more+t+'</div>'}).join("")+
 (tried?'<div class="row" style="margin:0 0 14px"><button class="btn" id="rank">Обновить рейтинг с учётом проб</button></div>':'')+
 '<div class="card"><h2>Что делать дальше</h2><p>Возьмите две профессии, которые «зарядили», и найдите по три интервью или дня из жизни специалистов. Затем попробуйте маленький проект: короткий курс, стажировку или тестовое задание.</p><p class="mute">Тест показывает склонности, а не приговор. Проценты — ориентир для размышления.</p><div class="row"><button class="btn" id="again">Пройти заново</button></div></div>';
 app.querySelectorAll("[data-op]").forEach(function(b){b.onclick=function(){st.op=b.dataset.op;st.ti=0;st.ta=[];render()}});
 app.querySelectorAll("[data-tv]").forEach(function(b){b.onclick=function(){
   st.ta.push(+b.dataset.tv);st.ti++;
   var mq=QB[st.op],code=P.filter(function(p){return p[0]===st.op})[0][1];
   if(st.ti<mq.length){render();return}
   var sum=st.ta.reduce(function(a,b){return a+b},0),pct=Math.max(1,Math.min(99,Math.round((sum-mq.length)/(mq.length*3)*100)));
   st.adj[st.op]=Math.round(pct/100*20-10);
   var l=code.split(""),newSc={};Object.keys(sc).forEach(function(k){newSc[k]=sc[k]});
   newSc[l[0]]=(newSc[l[0]]||0)+pct/100*4;if(l[1])newSc[l[1]]=(newSc[l[1]]||0)+pct/100*2;if(l[2])newSc[l[2]]=(newSc[l[2]]||0)+pct/100*1;
   var extra=buildAll(newSc).filter(function(r){return r.p[0]!==st.op&&st.ord.indexOf(r.ix)===-1}).sort(function(a,b){return b.base-a.base}).slice(0,2).map(function(r){return{name:r.p[0],pct:Math.max(1,Math.min(99,r.base))}});
   st.mt[st.op]={pct:pct,extra:extra};st.op="";st.ti=0;st.ta=[];render();
 }});
 var rk=document.getElementById("rank");if(rk)rk.onclick=function(){st.ord=null;render();window.scrollTo(0,0)};
 document.getElementById("again").onclick=function(){st.adj={};st.ord=null;st.op="";go("start")};
}
render();
</script>
</body>
</html> 